{
  "target_type": {
    "description": "探针目标类型",
    "type": "string",
    "hint": "private = 私聊（推荐，无痕）；group = 群聊（消息会闪现）",
    "default": "private"
  },
  "target_id": {
    "description": "探针目标 ID",
    "type": "string",
    "hint": "私聊填对方 QQ 号，群聊填群号",
    "default": ""
  },
  "interval_min": {
    "description": "探针间隔（分钟）",
    "type": "int",
    "default": 30
  },
  "recall_after_s": {
    "description": "撤回延迟（秒）",
    "type": "int",
    "default": 4
  },
  "probe_text": {
    "description": "探针消息内容",
    "type": "string",
    "default": "·"
  },
  "state_file": {
    "description": "发送时间戳状态文件",
    "type": "string",
    "hint": "供 qq-gate watchdog 读取，保持默认即可",
    "default": "/tmp/fish_probe_last"
  }
}
