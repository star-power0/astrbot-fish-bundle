{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true
  },
  "api_base": {
    "description": "TTS API 基础地址",
    "type": "string",
    "default": "https://api.xiaomimimo.com"
  },
  "api_key": {
    "description": "API Key",
    "type": "string",
    "default": ""
  },
  "model": {
    "description": "TTS 模型 ID",
    "type": "string",
    "default": "mimo-v2.5-tts-voicedesign"
  },
  "voice_desc": {
    "description": "默认音色描述",
    "type": "string",
    "hint": "人格没有专属音色时使用；留空 = 未配声人格不发语音",
    "default": ""
  },
  "voice_map": {
    "description": "人格专属音色映射",
    "type": "string",
    "hint": "JSON：{\"人格名\": \"音色描述\"}，如 {\"林娟\": \"十八到二十岁女大学生...\"}",
    "default": "{}"
  },
  "group_whitelist": {
    "description": "群聊语音白名单",
    "type": "string",
    "hint": "逗号分隔群号；留空 = 仅私聊可发语音",
    "default": ""
  },
  "timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 60
  },
  "tool_cooldown": {
    "description": "LLM 工具每人冷却（秒）",
    "type": "int",
    "hint": "0 = 不限",
    "default": 60
  }
}
